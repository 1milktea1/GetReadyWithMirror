# Copy this file to backend/.env and fill in the value there.
# backend/.env is gitignored. Do not put a real key in this file.

XAI_API_KEY=

# Optional. Defaults to grok-4.7.
# XAI_MODEL=grok-4.7

# ElevenLabs speech-to-text and speech synthesis. Server-side only.
ELEVENLABS_API_KEY=

# Optional voice. Defaults to a built-in ElevenLabs voice id.
# ELEVENLABS_VOICE_ID=
