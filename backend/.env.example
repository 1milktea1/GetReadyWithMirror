# Server-side only. The React app never receives this value.
# Enable the Directions API on the key, then start the backend with `npm run dev`
# (it loads this file when present) or export the variable yourself.
GOOGLE_MAPS_API_KEY=

# Set to 0 to skip Google and OSRM and serve the labeled Columbia → Soothr fixture.
# MAPS_LIVE=0
