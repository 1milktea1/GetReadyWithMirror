# Secrets — never commit provider credentials.
# Gemini, ElevenLabs, maps, and calendar keys stay server-side and out of Git.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo
coverage/
*.local

# Vercel CLI project link
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local database files (SQLite is not in scope yet, but keep them out by default)
*.sqlite
*.sqlite3
*.db

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
